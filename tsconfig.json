{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "moduleResolution": "bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "lib": ["esnext", "dom"],
    "types": ["react", "react-native"]
  },
  "include": ["app", "src", "index.ts", "index.html"]
}