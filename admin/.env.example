# Fabric Admin — every variable the Admin-1 build reads. Values are set on
# the admin host only (Vercel env on the fabric-admin project, or the
# self-host env file). NEVER commit real values.

# --- Database (plain Postgres >= 15; the whole move kit is this + env) ---
DATABASE_URL=

# --- Config signing (public config payload integrity) ---
CONFIG_SIGNING_SECRET=

# --- Admin auth ---
# TOTP secret encryption key (any long random string; hashed to the AES key)
TOTP_ENC_KEY=
# Seed inputs for `npm run create-admin` (used once, not read at runtime)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_TOTP_SECRET=

# --- Alerts (spec §4.4: email + one webhook) ---
ALERT_WEBHOOK_URL=
ALERT_EMAIL_TO=
ADMIN_EMAIL=
SMTP_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Probes / cron ---
# Shared secret the platform cron sends as the x-cron-secret header
CRON_SECRET=

# --- Public surface ---
# Gateway base URL published inside the public config payload
PUBLIC_GATEWAY_BASE_URL=

# --- Break-glass (§7.4): 1 = portal mutations refuse, reads/probes run ---
ADMIN_READ_ONLY=

# --- Provider keys referenced by ai_endpoints.credential_ref (env:NAME) ---
# Endpoint rows may instead carry a portal-entered key stored server-side.
# These names are examples of the reference pattern, one per preset:
META_MODEL_API_KEY=
FIREWORKS_API_KEY=
