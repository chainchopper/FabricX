# FabricX Environment Configuration

# WebRTC Signaling Server
# Default: ws://localhost:8080
# Production: wss://your-signaling-server.com
EXPO_PUBLIC_SIGNALING_SERVER_URL=ws://localhost:8080

# API Endpoints (if needed in future)
# EXPO_PUBLIC_API_URL=https://api.fabricx.app

# Fanalogy built-in cloud (Cleanup 2 — see docs/AI.md)
# Locks Fanalogy's own Meta Model API key + model into the build so
# the cloud tier (composer, ghost brain, SAM) works out of the box.
# Set these on the Vercel project (fabx), Production scope. NOTE:
# EXPO_PUBLIC_ values are visible in the shipped bundle — use a key
# behind a hard spend cap.
# EXPO_PUBLIC_FANALOGY_LLM_API_KEY=
# EXPO_PUBLIC_FANALOGY_LLM_BASE_URL=https://api.meta.ai/v1
# EXPO_PUBLIC_FANALOGY_LLM_MODEL=muse-spark-1.3

# Feature Flags
# EXPO_PUBLIC_ENABLE_AR_CAMERA=true
# EXPO_PUBLIC_ENABLE_MIDI_INPUT=true
# EXPO_PUBLIC_ENABLE_WEBRTC=true

# Device Configuration
# EXPO_PUBLIC_S3_MATRIX_DEFAULT_DEVICE=

# Debug Settings
# EXPO_PUBLIC_DEBUG_MODE=false
# EXPO_PUBLIC_LOG_LEVEL=info
